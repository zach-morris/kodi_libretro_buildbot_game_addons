msgctxt "Addon Summary"
msgid "Nintendo - SNES / SFC (Snes9x 2002)"
msgstr ""

msgctxt "Addon Description"
msgid "A port of SNES9x 1.39 for libretro. Previously called PocketSNES, this emulator is heavily optimized for ARM."
msgstr ""

msgctxt "#30001"
msgid "Frameskip"
msgstr ""

msgctxt "#30002"
msgid "Frameskip Threshold (%)"
msgstr ""

msgctxt "#30003"
msgid "Frameskip Interval"
msgstr ""

msgctxt "#30004"
