<?xml version="1.0" encoding="UTF-8"?>
<addon id="game.libretro.azahar"
		name="Nintendo - 3DS (Azahar)"
		version="2127.0.0.1"
		provider-name="Azahar Emulator">
	<requires>
		<import addon="game.libretro" version="1.0.0"/>
	</requires>
	<extension point="kodi.gameclient"
			library_@PLATFORM@="@LIBRARY_FILENAME@">
		<platforms>Nintendo - 3DS</platforms>
		<extensions>3ds|3dsx|z3dsx|elf|axf|cci|zcci|cxi|zcxi|app|bcci|bcxi</extensions>
		<supports_vfs>false</supports_vfs>
		<supports_standalone>false</supports_standalone>
		<supports_disc_control>false</supports_disc_control>
		<libretro_core>azahar_libretro</libretro_core>
		<savestate_features>basic</savestate_features>
	</extension>
	<extension point="xbmc.addon.metadata">
		<license>GPLv3+</license>
		<platform>@PLATFORM@</platform>
		<source>https://github.com/kodi-game/game.libretro.azahar</source>
		<assets>
			<icon>resources/icon.png</icon>
		</assets>
		<summary lang="en_GB">Nintendo - 3DS (Azahar)</summary>
		<description lang="en_GB">Azahar is a Nintendo 3DS emulator, the successor of Citra.[CR][CR]Games must be decrypted.</description>
	</extension>
</addon>
