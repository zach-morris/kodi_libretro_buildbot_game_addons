<?xml version="1.0" encoding="UTF-8"?>
<addon id="game.libretro.stella2014"
		name="Atari - 2600 (Stella 2014)"
		version="3.9.3.6"
		provider-name="Stephen Anthony, Bradford Mott, Eckhard Stolberg, Brian Watson">
	<requires>
		<import addon="game.libretro" version="1.0.0"/>
		<import addon="game.controller.atari.2600" version="1.0.0"/>
	</requires>
	<extension point="kodi.gameclient"
			library_@PLATFORM@="@LIBRARY_FILENAME@">
		<platforms>Atari - 2600</platforms>
		<extensions>a26|bin|mvc</extensions>
		<supports_vfs>true</supports_vfs>
		<supports_standalone>false</supports_standalone>
		<supports_disc_control>false</supports_disc_control>
		<libretro_core>stella2014_libretro</libretro_core>
		<savestate_features>deterministic</savestate_features>
	</extension>
	<extension point="xbmc.addon.metadata">
		<license>GPLv2</license>
		<platform>@PLATFORM@</platform>
		<source>https://github.com/kodi-game/game.libretro.stella2014</source>
		<assets>
			<icon>resources/icon.png</icon>
			<screenshot>resources/screenshot-01.jpg</screenshot>
			<screenshot>resources/screenshot-02.jpg</screenshot>
			<screenshot>resources/screenshot-03.jpg</screenshot>
		</assets>
		<summary lang="en_GB">Atari - 2600 (Stella 2014)</summary>
		<description lang="en_GB">Stella is a multi-platform Atari 2600 VCS emulator.[CR][CR]The Atari 2600 Video Computer System (VCS), introduced in 1977, was the most popular home video game system of the early 1980s.</description>
		<disclaimer lang="en_GB">Stella was originally developed for Linux by Bradford W. Mott, and is currently maintained by Stephen Anthony.</disclaimer>
	</extension>
</addon>
