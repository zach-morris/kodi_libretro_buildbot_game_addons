<?xml version="1.0" encoding="UTF-8"?>
<addon id="game.libretro.ppsspp"
		name="Sony - PlayStation Portable (PPSSPP)"
		version="0.0.1.33"
		provider-name="Henrik Hrydgard">
	<requires>
		<import addon="game.libretro" version="1.0.0"/>
		<import addon="game.controller.psp" version="1.0.0"/>
	</requires>
	<extension point="kodi.gameclient"
			library_@PLATFORM@="@LIBRARY_FILENAME@">
		<platforms>Sony - PlayStation Portable</platforms>
		<extensions>elf|iso|cso|prx|pbp|chd</extensions>
		<supports_vfs>false</supports_vfs>
		<supports_standalone>false</supports_standalone>
		<supports_disc_control>false</supports_disc_control>
		<libretro_core>ppsspp_libretro</libretro_core>
		<savestate_features>serialized</savestate_features>
	</extension>
	<extension point="xbmc.addon.metadata">
