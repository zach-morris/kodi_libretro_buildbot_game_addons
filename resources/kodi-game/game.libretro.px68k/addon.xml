<?xml version="1.0" encoding="UTF-8"?>
<addon id="game.libretro.px68k"
		name="Sharp - X68000 (PX68k)"
		version="0.15.0.42"
		provider-name="hissorii">
	<requires>
		<import addon="game.libretro" version="1.0.0"/>
		<import addon="game.controller.msx.joystick" version="1.0.0"/>
		<import addon="game.controller.keyboard" version="1.0.0"/>
		<import addon="game.controller.mouse" version="1.0.0"/>
	</requires>
	<extension point="kodi.gameclient"
			library_@PLATFORM@="@LIBRARY_FILENAME@">
		<platforms>Sharp - X68000</platforms>
		<extensions>dim|img|d88|88d|hdm|dup|2hd|xdf|hdf|cmd|m3u</extensions>
		<supports_vfs>false</supports_vfs>
		<supports_standalone>true</supports_standalone>
		<supports_disc_control>true</supports_disc_control>
		<libretro_core>px68k_libretro</libretro_core>
	</extension>
