<?xml version="1.0" encoding="UTF-8"?>
<addon id="game.libretro.lrps2"
		name="Sony - PlayStation 2 (LRPS2)"
		version="2.0.0.15"
		provider-name="PCSX2 Team">
	<requires>
		<import addon="game.libretro" version="1.0.0"/>
		<import addon="game.controller.ps.dualshock" version="1.0.0"/>
		<import addon="game.controller.ps.dualanalog" version="1.0.0"/>
		<import addon="game.controller.ps.gamepad" version="1.0.0"/>
	</requires>
	<extension point="kodi.gameclient"
			library_@PLATFORM@="@LIBRARY_FILENAME@">
		<platforms>Sony - PlayStation 2</platforms>
		<extensions>elf|iso|ciso|cue|gz|chd|cso|zso|m3u</extensions>
		<supports_vfs>false</supports_vfs>
		<supports_standalone>true</supports_standalone>
		<supports_disc_control>true</supports_disc_control>
		<libretro_core>pcsx2_libretro</libretro_core>
		<savestate_features>basic</savestate_features>
	</extension>
	<extension point="xbmc.addon.metadata">
		<license>GPLv3</license>
		<platform>@PLATFORM@</platform>
		<source>https://github.com/kodi-game/game.libretro.lrps2</source>
		<assets>
			<icon>resources/icon.png</icon>
		</assets>
