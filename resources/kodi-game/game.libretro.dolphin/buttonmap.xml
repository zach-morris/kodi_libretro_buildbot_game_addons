<?xml version="1.0" encoding="UTF-8"?>
<buttonmap version="2">
	<controller id="game.controller.gamecube" type="RETRO_DEVICE_JOYPAD">
		<feature name="a" mapto="RETRO_DEVICE_ID_JOYPAD_A"/>
		<feature name="b" mapto="RETRO_DEVICE_ID_JOYPAD_B"/>
		<feature name="x" mapto="RETRO_DEVICE_ID_JOYPAD_X"/>
		<feature name="y" mapto="RETRO_DEVICE_ID_JOYPAD_Y"/>
		<feature name="z" mapto="RETRO_DEVICE_ID_JOYPAD_R"/>
		<feature name="l" mapto="RETRO_DEVICE_ID_JOYPAD_L2"/>
		<feature name="r" mapto="RETRO_DEVICE_ID_JOYPAD_R2"/>
		<feature name="start" mapto="RETRO_DEVICE_ID_JOYPAD_START"/>
		<feature name="up" mapto="RETRO_DEVICE_ID_JOYPAD_UP"/>
		<feature name="down" mapto="RETRO_DEVICE_ID_JOYPAD_DOWN"/>
		<feature name="left" mapto="RETRO_DEVICE_ID_JOYPAD_LEFT"/>
		<feature name="right" mapto="RETRO_DEVICE_ID_JOYPAD_RIGHT"/>
		<feature name="controlstick" mapto="RETRO_DEVICE_INDEX_ANALOG_LEFT"/>
		<feature name="cstick" mapto="RETRO_DEVICE_INDEX_ANALOG_RIGHT"/>
		<feature name="motor" mapto="RETRO_RUMBLE_STRONG"/>
	</controller>
	<!--
	    The Wii Remote is a plain joypad on the wire: Dolphin defines
	    RETRO_DEVICE_WIIMOTE as RETRO_DEVICE_JOYPAD and reads it as a Wii
	    Remote whenever the running title is a Wii one, so no subclass is
	    needed. The GameCube controller above is the same device type, which
	    is why both are offered on every port - the one to pick is the one the
	    game expects, and Dolphin interprets it by title.

	    The mapping is not the obvious one. Dolphin binds 1 and 2 to X and Y,
	    minus and plus to Select and Start, and Home to R3, so those are what
	    the features have to be sent as.
	-->
	<controller id="game.controller.wiimote" type="RETRO_DEVICE_JOYPAD">
		<feature name="a" mapto="RETRO_DEVICE_ID_JOYPAD_A"/>
		<feature name="b" mapto="RETRO_DEVICE_ID_JOYPAD_B"/>
		<feature name="one" mapto="RETRO_DEVICE_ID_JOYPAD_X"/>
		<feature name="two" mapto="RETRO_DEVICE_ID_JOYPAD_Y"/>
		<feature name="minus" mapto="RETRO_DEVICE_ID_JOYPAD_SELECT"/>
		<feature name="plus" mapto="RETRO_DEVICE_ID_JOYPAD_START"/>
		<feature name="home" mapto="RETRO_DEVICE_ID_JOYPAD_R3"/>
		<feature name="up" mapto="RETRO_DEVICE_ID_JOYPAD_UP"/>
		<feature name="down" mapto="RETRO_DEVICE_ID_JOYPAD_DOWN"/>
		<feature name="left" mapto="RETRO_DEVICE_ID_JOYPAD_LEFT"/>
		<feature name="right" mapto="RETRO_DEVICE_ID_JOYPAD_RIGHT"/>
	</controller>
	<!--
	    A Wii Remote with a Classic Controller plugged in is Dolphin's device
	    (4 << 8) | RETRO_DEVICE_JOYPAD, which is subclass 3. Its analog L and R
	    triggers are read from the analog L2 and R2, and ZL and ZR from L and R.
	-->
	<controller id="game.controller.wii.classic" type="RETRO_DEVICE_JOYPAD" subclass="3">
		<feature name="a" mapto="RETRO_DEVICE_ID_JOYPAD_A"/>
		<feature name="b" mapto="RETRO_DEVICE_ID_JOYPAD_B"/>
		<feature name="x" mapto="RETRO_DEVICE_ID_JOYPAD_X"/>
		<feature name="y" mapto="RETRO_DEVICE_ID_JOYPAD_Y"/>
		<feature name="minus" mapto="RETRO_DEVICE_ID_JOYPAD_SELECT"/>
		<feature name="plus" mapto="RETRO_DEVICE_ID_JOYPAD_START"/>
		<feature name="home" mapto="RETRO_DEVICE_ID_JOYPAD_R3"/>
		<feature name="up" mapto="RETRO_DEVICE_ID_JOYPAD_UP"/>
		<feature name="down" mapto="RETRO_DEVICE_ID_JOYPAD_DOWN"/>
		<feature name="left" mapto="RETRO_DEVICE_ID_JOYPAD_LEFT"/>
		<feature name="right" mapto="RETRO_DEVICE_ID_JOYPAD_RIGHT"/>
		<feature name="zl" mapto="RETRO_DEVICE_ID_JOYPAD_L"/>
		<feature name="zr" mapto="RETRO_DEVICE_ID_JOYPAD_R"/>
		<feature name="l" mapto="RETRO_DEVICE_ID_JOYPAD_L2"/>
		<feature name="r" mapto="RETRO_DEVICE_ID_JOYPAD_R2"/>
		<feature name="leftstick" mapto="RETRO_DEVICE_INDEX_ANALOG_LEFT"/>
		<feature name="rightstick" mapto="RETRO_DEVICE_INDEX_ANALOG_RIGHT"/>
	</controller>
</buttonmap>
