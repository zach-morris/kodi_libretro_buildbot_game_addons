<?xml version="1.0" encoding="UTF-8"?>
<addon id="game.libretro.flycast"
		name="Sega - Dreamcast/Naomi (Flycast)"
		version="0.1.0.71"
		provider-name="flyinghead">
	<requires>
		<import addon="game.libretro" version="1.0.0"/>
		<import addon="game.controller.dreamcast" version="1.0.0"/>
	</requires>
	<extension point="kodi.gameclient"
			library_@PLATFORM@="@LIBRARY_FILENAME@">
		<platforms>Sega - Dreamcast/Naomi</platforms>
		<extensions>chd|cdi|elf|cue|gdi|lst|bin|dat|zip|7z|m3u</extensions>
		<supports_vfs>false</supports_vfs>
		<supports_standalone>true</supports_standalone>
		<supports_disc_control>true</supports_disc_control>
		<libretro_core>flycast_libretro</libretro_core>
		<savestate_features>serialized</savestate_features>
	</extension>
